// Zed settings. Content is identical on every OS, but the destination is
// not — Linux reads ~/.config/zed/settings.json while macOS reads
// ~/Library/Application Support/Zed/settings.json — so this is installed by
// the per-OS apps component rather than install-dotfiles.sh.
//
// Tracked as .jsonc and installed as .json: Zed reads its settings as JSONC
// so the comments below survive, but a bare settings.json sitting in a repo
// gets linted as strict JSON, which flags every comment as an error.
{
  // ------------------------------------------------------------------- cli
  // `zed <path>` gets its own window instead of adding the path to whichever
  // window happens to be focused, so an editor opened from a shell stays
  // scoped to the directory that shell was in. Zed still routes the path into
  // an open project when it is a subpath of one. Override per-invocation with
  // -e/--existing (current window) or -a/--add (add to current workspace).
  "cli_default_open_behavior": "new_window",

  // ----------------------------------------------------------------- agent
  // Written by Zed itself when the model is picked in the agent panel, so
  // expect it to be rewritten in place rather than hand-edited. No credential
  // belongs in this block: Zed keeps provider API keys in the system
  // credential store (or reads OPENCODE_API_KEY from the environment), never
  // in settings.json — which is what makes this file safe to track.
  "agent": {
    "default_model": {
      "provider": "opencode",
      "model": "go/kimi-k2.7-code",
      "enable_thinking": false
    },
    "favorite_models": [],
    "model_parameters": []
  },

  // ---------------------------------------------------------------- saving
  // Autosave a second after you stop typing, matching the VS Code config.
  // Zed also flushes an unsaved tab when it closes, even before the delay
  // elapses. With saves this frequent, anything that rewrites the file on
  // save would be reformatting your code mid-thought — hence the settings
  // immediately below.
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },

  // Saving writes exactly what you typed — no reformat, no trimming, no
  // appended newline — so a diff only ever shows lines you actually edited.
  // Kept deliberately in step with the VS Code config next door.
  "format_on_save": "off",
  "remove_trailing_whitespace_on_save": false,
  "ensure_final_newline_on_save": false,

  // Since nothing is trimmed automatically, surface stray whitespace rather
  // than leaving it invisible. Zed offers all/selection/none/boundary here —
  // there is no trailing-only mode as in VS Code, so boundary is the closest.
  "show_whitespaces": "boundary",

  // ------------------------------------------------------------ appearance
  // Same font as Ghostty and the fuzzel picker. calt enables the ligatures
  // JetBrainsMono ships.
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 13,
  "buffer_font_features": { "calt": true },
  "theme": "One Dark",
  "soft_wrap": "none",

  // The file tree lives on the left. This is Zed's default, but dragging the
  // panel across the window writes the new dock into the local settings and
  // it sticks — pinning it here keeps the layout the same on every machine.
  "project_panel": {
    "dock": "left"
  },

  // ------------------------------------------------------------------ java
  // Matches shared/ide/*-google-style.xml (indent 4, 120 columns) rather
  // than upstream Google style (2 / 100) — see the VS Code config for why.
  "languages": {
    "Java": {
      "tab_size": 4,
      "preferred_line_length": 120
    }
  },

  // ------------------------------------------------------------------ misc
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
